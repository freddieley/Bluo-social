NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name also supported for existing deployments:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by the username-login route. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@bluo.app

# Timetable OCR runs locally in the browser with PaddleOCR.js. No OCR API key is required.
